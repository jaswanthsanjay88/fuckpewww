{
  "manifest_version": 3,
  "name": "Fcuk-Pewww - Parul PDF Downloader",
  "version": "2.5",
  "description": "One-click Claude-styled PDF Downloader for Parul University eLearning.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.paruluniversity.ac.in/*",
        "*://elearning.paruluniversity.ac.in/*",
        "*://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "*://*.paruluniversity.ac.in/*",
        "*://elearning.paruluniversity.ac.in/*",
        "<all_urls>"
      ]
    }
  ]
}
